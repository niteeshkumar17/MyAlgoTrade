# ============================================================================
# /bot/.env.example — Oracle Cloud VM Environment Template (Indian NSE Market)
# Copy to /etc/aegis-bot/bot.env and lock permissions:
#   sudo chmod 600 /etc/aegis-bot/bot.env
# NEVER commit real keys to git.
# ============================================================================

# Hard Paper-Trading Guard (Bot refuses to start if PAPER_TRADING_ONLY != "true")
PAPER_TRADING_ONLY="true"
BROKER_PROVIDER="indian_nse_paper"
NSE_PAPER_ENDPOINT="https://paper-sandbox.nseindia-sim.local"

# Angel One SmartAPI Market Data Feed (Primary NSE Spot, L2 Depth, Option Greeks & 5m OHLCV)
ANGEL_API_KEY=""
ANGEL_CLIENT_CODE=""
ANGEL_MPIN=""
ANGEL_TOTP_SECRET=""

# Hosted Free Postgres (Neon or Supabase) — MUST use the bot_rw role
DATABASE_URL="postgresql://bot_rw:STRONG_BOT_PASSWORD@ep-cool-darkness-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Path to config.yaml
AEGIS_CONFIG_PATH="/opt/aegis-options-bot/bot/config.yaml"

# Optional Free Alerts (Telegram Bot API or SMTP Email)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALERT_SMTP_HOST=""
ALERT_SMTP_PORT="587"
ALERT_SMTP_USER=""
ALERT_SMTP_PASS=""
ALERT_EMAIL_TO=""

# Optional Oracle Object Storage Pre-Authenticated Request URL for nightly CSV backup upload
OCI_PAR_BACKUP_UPLOAD_URL=""
