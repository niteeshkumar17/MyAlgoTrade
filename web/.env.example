# ============================================================================
# /web/.env.example — Vercel Environment Variables Template
# Add these in Vercel Dashboard -> Settings -> Environment Variables.
# NEVER expose these with NEXT_PUBLIC_ prefix!
# ============================================================================

# Pooled / Serverless Postgres connection string using the READ-ONLY `web_ro` role
# (On Neon: enable "Pooled connection" which adds `-pooler` to the hostname)
DATABASE_URL_WEB_RO="postgresql://web_ro:STRONG_WEB_PASSWORD@ep-cool-darkness-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional passcode to protect the entire dashboard via Next.js Middleware (leave blank to disable)
DASHBOARD_PASSCODE=""

# Required secret passcode to toggle the "Pause / Resume new entries" switch in `control`
CONTROL_PAUSE_SECRET="change-me-pause-secret"
